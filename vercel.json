{
  "version": 2,
  "installCommand": "bash vercel-install.sh",
  "buildCommand": "rustup target add wasm32-unknown-unknown && cargo install trunk && trunk build --release",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://close-siusan-jaesea-21c201ce.koyeb.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
